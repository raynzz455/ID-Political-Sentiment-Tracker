# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Python caches (should never be tracked)
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
venv/

# Tool artifacts (Read/Grep tool output — not source code)
/tool-results/

# Fine-tuning outputs (model weights, metrics — too large for git)
/finetuning/runs/
finetuning/runs/

# Backup bundles
*.bundle

# Git bundle artifacts (should never be in repo)
*.git.bundle
v4-finetuning-bundle.git

# Patch files (applied patches, not source)
*.patch

# Databases (local SQLite — binary, changes constantly)
db/*.db
db/*.db-journal
db/*.sqlite
db/*.sqlite3

# Process ID files (ephemeral)
*.pid

# Upload/download scratch folders (user-generated, not source)
/upload/
/download/

# Supabase temp (use infra/supabase/ for real config)
/supabase/

# Project scaffold planning docs (outdated, kept in docs/ instead)
project-schafold.md
project-scaffold.md

# OS files
Thumbs.db
ehthumbs.db